<?xml version="1.0" encoding="utf-8"?>
<!-- 로그인 정보(세션)와 사진 캐시가 클라우드 백업이나 새 기기로 옮겨지지 않게 모두 뺀다. Android 12 이상에서 쓴다. -->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="root" />
        <exclude domain="file" />
        <exclude domain="database" />
        <exclude domain="sharedpref" />
        <exclude domain="external" />
    </device-transfer>
</data-extraction-rules>
